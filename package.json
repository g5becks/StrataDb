{
  "name": "stratadb",
  "version": "0.6.0",
  "description": "Type-safe embedded document database for Bun with MongoDB-like queries",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "deepmerge-ts": "^7.1.5",
    "fast-safe-stringify": "^2.1.1",
    "p-retry": "^7.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/bun": "1.4.4",
    "@types/node": "^26",
    "arktype": "^2.1.27",
    "backlog.md": "1.55.3",
    "expect-type": "^1.3.0",
    "fast-check": "4.10.2",
    "lefthook": "^2.0.4",
    "mitata": "^1.0.34",
    "tsdown": "^0.23.7",
    "type-fest": "^5.2.0",
    "typescript": "~7.0.2",
    "ultracite": "6.3.4",
    "valibot": "^1.1.0",
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:types": "tsc --noEmit -p test/type/tsconfig.json",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "check": "bun run typecheck && bun run lint",
    "prepare": "lefthook install",
    "bench": "bun run bench/query-translation.bench.ts",
    "bench:crud": "bun run bench/crud-operations.bench.ts",
    "bench:batch": "bun run bench/batch-throughput.bench.ts",
    "bench:all": "bun run bench && bun run bench:crud && bun run bench:batch",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "test:consumer": "bun run build && bun scripts/smoke-consumer.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g5becks/StrataDb.git"
  },
  "homepage": "https://g5becks.github.io/StrataDB/",
  "bugs": {
    "url": "https://github.com/g5becks/StrataDb/issues"
  },
  "keywords": [
    "bun",
    "sqlite",
    "document-database",
    "typescript",
    "embedded"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.4"
  }
}
