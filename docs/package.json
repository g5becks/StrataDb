{
  "name": "stratadb-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "typedoc --options ../typedoc.json && bun finalize-api.ts",
    "build": "bun run api && vitepress build .",
    "dev": "bun run api && vitepress dev .",
    "preview": "vitepress preview ."
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "typedoc": "~0.28.20",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "vitepress": "1.6.3",
    "vitepress-carbon": "^1.5.0"
  }
}
